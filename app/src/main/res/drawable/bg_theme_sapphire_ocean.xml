    <path android:fillColor="#38BDF8" android:fillAlpha="0.6" android:pathData="M320,440 A3.5,3.5 0 1 0 320,447 A3.5,3.5 0 1 0 320,440 Z" />
    <path android:fillColor="#BAE6FD" android:fillAlpha="0.7" android:pathData="M60,540 A2.5,2.5 0 1 0 60,545 A2.5,2.5 0 1 0 60,540 Z" />

