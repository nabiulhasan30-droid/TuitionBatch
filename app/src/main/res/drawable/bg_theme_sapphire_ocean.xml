            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="800">
                <item android:offset="0.0" android:color="#031E3D" />
                <item android:offset="0.35" android:color="#072B54" />
                <item android:offset="0.7" android:color="#051D3A" />
                <item android:offset="1.0" android:color="#020C18" />
            </gradient>
        </aapt:attr>
