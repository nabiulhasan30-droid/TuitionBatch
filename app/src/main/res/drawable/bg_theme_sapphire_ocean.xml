                <item android:offset="0.65" android:color="#180369A1" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Deep Sea Reef / Abyss Silhouette at Bottom -->
    <path
        android:fillColor="#010A14"
        android:pathData="M-10,720 Q70,660 160,700 T340,680 Q380,670 410,720 L410,800 L-10,800 Z" />

    <!-- Luminescent Aquatic Particles & Bubbles -->
