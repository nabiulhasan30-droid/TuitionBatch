    <path
        android:pathData="M180,-20 L310,580 L250,580 L140,-20 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="160"
                android:startY="0"
                android:endX="280"
                android:endY="580">
