    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Floating Smart Batch Schedule Tablet Card (Behind Cap) -->
    <!-- Card Drop Shadow -->
    <path
        android:fillColor="#15000000"
        android:pathData="M 31,44 L 77,44 A 6,6 0 0 1 83,50 L 83,82 A 6,6 0 0 1 77,88 L 31,88 A 6,6 0 0 1 25,82 L 25,50 A 6,6 0 0 1 31,44 Z" />

    <!-- Card Base with Frosted Gradient -->
    <path
        android:pathData="M 32,42 L 76,42 A 5,5 0 0 1 81,47 L 81,80 A 5,5 0 0 1 76,85 L 32,85 A 5,5 0 0 1 27,80 L 27,47 A 5,5 0 0 1 32,42 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="27"
                android:startY="42"
                android:endX="81"
                android:endY="85">
                <item android:offset="0.0" android:color="#E6FFFFFF" />
                <item android:offset="1.0" android:color="#BBE0F2FE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Card Top Header Bar -->
    <path
        android:pathData="M 32,42 L 76,42 A 5,5 0 0 1 81,47 L 81,51 L 27,51 L 27,47 A 5,5 0 0 1 32,42 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="27"
                android:startY="42"
                android:endX="81"
                android:endY="51">
                <item android:offset="0.0" android:color="#0284C7" />
                <item android:offset="1.0" android:color="#0369A1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Schedule Batch Rows inside the Card -->
    <!-- Row 1 -->
    <path android:fillColor="#0284C7" android:pathData="M33,56 L47,56 A1.5,1.5 0 0 1 47,59 L33,59 A1.5,1.5 0 0 1 33,56 Z" />
    <path android:fillColor="#10B981" android:pathData="M70,56 L75,56 A1.5,1.5 0 0 1 75,59 L70,59 A1.5,1.5 0 0 1 70,56 Z" />

    <!-- Row 2 -->
    <path android:fillColor="#64748B" android:pathData="M33,63 L52,63 A1.5,1.5 0 0 1 52,66 L33,66 A1.5,1.5 0 0 1 33,63 Z" />
    <path android:fillColor="#F59E0B" android:pathData="M70,63 L75,63 A1.5,1.5 0 0 1 75,66 L70,66 A1.5,1.5 0 0 1 70,63 Z" />

    <!-- Row 3 -->
    <path android:fillColor="#94A3B8" android:pathData="M33,70 L44,70 A1.5,1.5 0 0 1 44,73 L33,73 A1.5,1.5 0 0 1 33,70 Z" />
    <path android:fillColor="#06B6D4" android:pathData="M70,70 L75,70 A1.5,1.5 0 0 1 75,73 L70,73 A1.5,1.5 0 0 1 70,70 Z" />

    <!-- 2. The 3D Masterpiece Graduation Cap (Mortarboard) -->
    <!-- Mortarboard Shadow -->
    <path
        android:fillColor="#22000000"
        android:pathData="M 54,30 L 86,43 L 54,56 L 22,43 Z" />

    <!-- Lower Skull Cap Base (Under the Board) -->
    <path
        android:pathData="M 38,44 L 38,54 C 38,62 45,67 54,67 C 63,67 70,62 70,54 L 70,44 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="38"
                android:startY="44"
                android:endX="70"
                android:endY="67">
                <item android:offset="0.0" android:color="#0F172A" />
                <item android:offset="1.0" android:color="#1E293B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Skull Cap Golden Trim -->
    <path
        android:pathData="M 40,54 C 42,60 47,64 54,64 C 61,64 66,60 68,54"
        android:strokeWidth="1.2"
        android:strokeColor="#F59E0B" />

    <!-- Mortarboard Diamond Top (Left/Bottom Facet - Darker Midnight Velvet) -->
    <path
        android:pathData="M 54,26 L 20,39 L 54,52 L 54,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="20"
                android:startY="26"
                android:endX="54"
                android:endY="52">
                <item android:offset="0.0" android:color="#1E293B" />
                <item android:offset="1.0" android:color="#0F172A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Mortarboard Diamond Top (Right/Top Facet - Glossy Royal Midnight) -->
    <path
        android:pathData="M 54,26 L 88,39 L 54,52 L 54,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="26"
                android:endX="88"
                android:endY="52">
                <item android:offset="0.0" android:color="#334155" />
                <item android:offset="1.0" android:color="#1E293B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Edge Bevel Rim Highlight (Gleaming Cyan & Pure White Edge) -->
    <path
        android:pathData="M 20,39 L 54,26 L 88,39"
        android:strokeWidth="1.2"
        android:strokeAlpha="0.75"
        android:strokeColor="#38BDF8" />

    <!-- Center Button on Cap -->
    <path
        android:fillColor="#F59E0B"
        android:pathData="M 54,37 A 2.2,2.2 0 1 0 54,41.4 A 2.2,2.2 0 1 0 54,37 Z" />

    <!-- Golden Metallic Tassel Ribbon & Fringes -->
    <!-- Tassel Cord -->
    <path
        android:pathData="M 54,39 C 68,39 78,44 80,51 L 80,62"
        android:strokeWidth="1.6"
        android:strokeColor="#F59E0B" />

    <!-- Tassel Ring Clip -->
    <path
        android:fillColor="#FDE68A"
        android:pathData="M 78,61 L 82,61 L 82,63 L 78,63 Z" />

    <!-- Tassel Brush / Fringe -->
    <path
        android:pathData="M 77.5,63 L 82.5,63 L 84,72 L 76,72 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="76"
                android:startY="63"
                android:endX="84"
                android:endY="72">
                <item android:offset="0.0" android:color="#F59E0B" />
                <item android:offset="0.5" android:color="#FDE68A" />
                <item android:offset="1.0" android:color="#D97706" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. Brilliant Golden Star of Excellence (Upper Right) -->
    <path
        android:pathData="M 85,24 L 86.8,28 L 91,28.5 L 88,31.2 L 88.8,35.5 L 85,33.2 L 81.2,35.5 L 82,31.2 L 79,28.5 L 83.2,28 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="85"
                android:centerY="29"
                android:gradientRadius="7">
                <item android:offset="0.0" android:color="#FFFBEB" />
                <item android:offset="0.4" android:color="#FDE68A" />
                <item android:offset="1.0" android:color="#F59E0B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Mini Ambient Sparkle Left -->
    <path
        android:fillColor="#38BDF8"
        android:fillAlpha="0.85"
        android:pathData="M 23,28 L 24,25 L 27,26 L 24,27 L 23,30 L 22,27 L 19,26 L 22,25 Z" />

</vector>
