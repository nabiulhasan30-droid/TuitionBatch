    android:width="400dp"
    android:height="800dp"
    android:viewportWidth="400"
    android:viewportHeight="800">

    <!-- Twilight Evening Sky Gradient -->
    <path
        android:pathData="M0,0h400v800h-400z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="800">
                <item android:offset="0.0" android:color="#1A0A1E" />
                <item android:offset="0.35" android:color="#3B122D" />
                <item android:offset="0.6" android:color="#6B1D2F" />
                <item android:offset="0.75" android:color="#A83228" />
                <item android:offset="0.88" android:color="#D9531E" />
                <item android:offset="1.0" android:color="#1A060A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Golden Setting Sun -->
    <path
        android:pathData="M150,520 A50,50 0 1 0 250,520 A50,50 0 1 0 150,520 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="200"
                android:centerY="520"
                android:gradientRadius="60">
                <item android:offset="0.0" android:color="#FFFBEB" />
                <item android:offset="0.4" android:color="#FDE68A" />
                <item android:offset="0.8" android:color="#F59E0B" />
                <item android:offset="1.0" android:color="#EF4444" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Warm Atmospheric Sun Halo -->
    <path
        android:pathData="M0,420h400v200h-400z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="200"
                android:centerY="520"
                android:gradientRadius="200">
                <item android:offset="0.0" android:color="#50F59E0B" />
                <item android:offset="0.5" android:color="#25EA580C" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Silhouetted Rolling Hills -->
    <path
        android:fillColor="#1C060D"
        android:pathData="M-20,620 Q90,560 200,600 T420,570 L420,800 L-20,800 Z" />

    <path
        android:fillColor="#0D0206"
        android:pathData="M-20,680 Q140,630 280,670 T420,650 L420,800 L-20,800 Z" />

