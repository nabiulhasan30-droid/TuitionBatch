    <path
        android:fillColor="#0D0206"
        android:pathData="M330,670 Q327,620 325,570 L326,570 Q328,620 331,670 Z M325,570 Q305,555 290,565 M325,570 Q315,545 310,535 M325,570 Q335,545 345,540 M325,570 Q345,555 360,565"
