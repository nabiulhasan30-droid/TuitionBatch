    <path android:fillColor="#FDE68A" android:fillAlpha="0.8" android:pathData="M110,120 A1.8,1.8 0 1 0 110,123.6 A1.8,1.8 0 1 0 110,120 Z" />
    <path android:fillColor="#FFFFFF" android:fillAlpha="0.9" android:pathData="M290,90 A2.2,2.2 0 1 0 290,94.4 A2.2,2.2 0 1 0 290,90 Z" />
    <path android:fillColor="#FDE68A" android:fillAlpha="0.7" android:pathData="M60,220 A1.5,1.5 0 1 0 60,223 A1.5,1.5 0 1 0 60,220 Z" />
    <path android:fillColor="#FFFFFF" android:fillAlpha="0.6" android:pathData="M350,260 A1.8,1.8 0 1 0 350,263.6 A1.8,1.8 0 1 0 350,260 Z" />

