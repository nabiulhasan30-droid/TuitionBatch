    <path
        android:fillColor="#0D0206"
        android:pathData="M70,680 Q73,630 75,580 L76,580 Q74,630 72,680 Z M75,580 Q55,565 40,575 M75,580 Q65,555 60,545 M75,580 Q85,555 95,550 M75,580 Q95,565 110,575 M75,580 Q75,550 78,540"
